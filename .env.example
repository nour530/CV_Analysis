# JobMatch AI environment template. Copy to .env and fill in locally.
# Never commit a real API key or copy this file with credentials in place.

LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=replace-with-a-model-supported-by-your-account
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# Optional: set to 1 to allow the synthetic live integration test to run.
# RUN_OPENAI_INTEGRATION_TESTS=0

# Runtime mode: development, test, or production.
# Production requires COOKIE_SECURE=true, ENABLE_HSTS=true, HTTPS CORS origins,
# and a non-placeholder, high-entropy JWT_SECRET_KEY.
APP_ENV=development

# FastAPI service
API_TITLE=JobMatch AI API
API_VERSION=1.0.0
API_PREFIX=/api/v1
# Path to the generated job feature table used by the job catalog.
# Defaults to ai-engine/data/features/job_features.csv when unset.
# JOBS_FEATURES_PATH=C:/path/to/job_features.csv
CORS_ORIGINS=http://localhost:4200

# Real job postings. Run `python -m app.cli sync-jobs` to fetch jobs from the
# employer job-board APIs listed in JOB_SOURCES_PATH (default
# ai-engine/data/job_sources.json). JOBS_CATALOG_SOURCE: database = only synced
# jobs; auto = synced jobs, or the research dataset while none are synced yet;
# dataset = research dataset only (tests and offline development).
# JOBS_CATALOG_SOURCE=auto
# JOBS_CATALOG_REFRESH_SECONDS=300
# JOB_SOURCES_PATH=C:/path/to/job_sources.json
# Docker Compose job-sync interval (default 6 hours; minimum 900 seconds).
# JOB_SYNC_INTERVAL_SECONDS=21600
# CV uploads accept TXT, PDF, and DOCX. MAX_TEXT_LENGTH applies to extracted text.
MAX_TEXT_LENGTH=200000
MAX_UPLOAD_BYTES=5000000
# Maximum bytes accepted in any HTTP request body before a 413 is returned.
MAX_REQUEST_BODY_BYTES=8000000
# Extraction resource limits for uploaded PDF and DOCX documents.
MAX_PDF_PAGES=100
MAX_DOCX_ENTRIES=2000
MAX_DOCX_UNCOMPRESSED_BYTES=50000000
MAX_DOCX_COMPRESSION_RATIO=200
DEFAULT_RECOMMENDATION_LIMIT=10
MAX_RECOMMENDATION_LIMIT=50
DEFAULT_CANDIDATE_POOL_SIZE=30
MAX_CANDIDATE_POOL_SIZE=200

# Server-level gate for sending résumé/job text to OpenAI.
# Per-request allow_remote_analysis is still required; keep this false by default.
ALLOW_REMOTE_LLM_ANALYSIS=false

# Database. If unset, the API uses ai-engine/data/jobmatch.db for local SQLite.
# Production requires PostgreSQL and DATABASE_URL. Apply migrations before
# starting the API: alembic upgrade head
# DATABASE_URL=postgresql+psycopg://jobmatch:password@localhost:5432/jobmatch
# AUTO_CREATE_TABLES=false
# PostgreSQL connection pool settings (ignored for SQLite).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=5

# Authentication. JWT_SECRET_KEY is required and must be at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is rejected at startup; replace it before launching the API.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=jobmatch-ai
JWT_AUDIENCE=jobmatch-ai-web
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800
SESSION_SECONDS=2592000

# Refresh and CSRF cookies. HTTPS and secure cookies are required in production.
# COOKIE_SAMESITE=none requires COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=

# API rate limits. Use Redis shared storage when running multiple workers or
# instances; the memory backend is process-local and is intended for local
# development and tests. LOGIN_RATE_LIMIT_ATTEMPTS applies to the account across
# all client IPs; the per-IP login limit is 4x this value.
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT_ATTEMPTS=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_CHANGE_RATE_LIMIT_ATTEMPTS=5
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_KEYS=20000

# Shared rate-limit and quota storage. RATE_LIMIT_BACKEND=auto selects Redis when
# REDIS_URL is set, otherwise memory outside production. Production with auto
# requires REDIS_URL. Set RATE_LIMIT_BACKEND=memory only for a deliberate
# single-process deployment. Redis failures fail closed by default.
# RATE_LIMIT_BACKEND=auto
# REDIS_URL=redis://localhost:6379/0
# REDIS_KEY_PREFIX=jobmatch:rate_limit:
# REDIS_CONNECT_TIMEOUT_SECONDS=1.0
# REDIS_SOCKET_TIMEOUT_SECONDS=1.0
# REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# REDIS_MAX_CONNECTIONS=100
# RATE_LIMIT_REDIS_FAILURE_MODE=closed

# Per-user usage quotas. These are separate from IP/account rate limits and are
# also per-process in-memory counters. Set an attempt value to 0 to disable that
# quota. Keep defaults generous enough for normal UI navigation.
USER_QUOTA_CV_ANALYSIS_ATTEMPTS=30
USER_QUOTA_CV_ANALYSIS_WINDOW_SECONDS=3600
USER_QUOTA_JOB_MATCH_ATTEMPTS=60
USER_QUOTA_JOB_MATCH_WINDOW_SECONDS=3600
USER_QUOTA_RECOMMENDATIONS_ATTEMPTS=30
USER_QUOTA_RECOMMENDATIONS_WINDOW_SECONDS=3600
USER_QUOTA_REMOTE_LLM_ATTEMPTS=20
USER_QUOTA_REMOTE_LLM_WINDOW_SECONDS=3600

# Reject passwords from the local common-password blocklist at registration and
# password change. Rejections are audited without logging the password.
COMMON_PASSWORD_CHECK_ENABLED=true

# Retention for expired/revoked sessions and stale refresh tokens. Run
# `python -m app.cli cleanup-sessions` (optionally with --dry-run) from a
# scheduler. Keep windows long enough to investigate recent session activity.
SESSION_CLEANUP_RETENTION_SECONDS=2592000
REFRESH_TOKEN_CLEANUP_RETENTION_SECONDS=2592000

# Comma-separated trusted reverse proxy IP addresses or CIDR ranges.
# X-Forwarded-For is honored only when the direct peer is in this list.
# Leave empty when clients connect directly to the API.
# TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.0/8

# Enable only behind HTTPS. Must be true when APP_ENV=production.
ENABLE_HSTS=false

# Application logging. LOG_JSON emits structured JSON for application and
# operational events. It defaults to true in production. LOG_LEVEL accepts
# CRITICAL, ERROR, WARNING, INFO, or DEBUG.
LOG_LEVEL=INFO
# LOG_JSON=false

# Security audit logging. Events are JSON lines on the jobmatch.audit logger and
# alerts use jobmatch.security.alert. Ship them to your centralized log platform.
# When no root logging handler is configured, the API attaches a stream handler.
AUDIT_LOG_LEVEL=INFO

# API docs are exposed in development/test and disabled by default in production.
# Set ENABLE_API_DOCS=true only when docs are protected by an external access layer.
# ENABLE_API_DOCS=true

# Docker Compose deployment values. Copy this file to .env before running
# `docker compose up`. Use URL-safe passwords or a separately URL-encoded
# DATABASE_URL. CORS_ORIGINS must be the public HTTPS frontend origin in
# production. FRONTEND_PORT is the only published service port.
# POSTGRES_DB=jobmatch
# POSTGRES_USER=jobmatch
# POSTGRES_PASSWORD=replace-with-a-strong-database-password
# FRONTEND_PORT=8080
# UVICORN_WORKERS=2
# TRUSTED_PROXY_IPS=172.28.0.0/16
